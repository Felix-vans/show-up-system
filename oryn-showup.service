# Alternatief voor PM2. Gebruik dit bestand ALLEEN als je liever systemd
# gebruikt in plaats van PM2 (zie DEPLOY.md, Deel 3) — niet allebei
# tegelijk, dat botst op dezelfde poort.

[Unit]
Description=Oryn Show-Up System
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# ---- AANPASSEN indien nodig -------------------------------------
# Vervang 'felix' door je Linux-gebruikersnaam op de server, en het pad
# door de map waarin je de repo hebt gecloned.
User=felix
WorkingDirectory=/home/felix/show-up-system
# De poort komt uit BIND in .env — dus je past hem maar op één plek aan.
ExecStart=/home/felix/show-up-system/.venv/bin/gunicorn \
    --workers 2 \
    --threads 4 \
    --timeout 60 \
    --bind ${BIND} \
    wsgi:app
# -----------------------------------------------------------------

EnvironmentFile=/home/felix/show-up-system/.env

# Herstart automatisch bij een crash
Restart=always
RestartSec=5

# Logging naar journalctl
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
