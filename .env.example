# ------------------------------------------------------------------
# Oryn Show-Up System — instellingen
# Kopieer dit bestand naar .env en vul in. .env staat in .gitignore en
# komt dus NOOIT op GitHub terecht.
# ------------------------------------------------------------------

# --- Mailbox waaruit verstuurd wordt ------------------------------
# Tijdelijk delen alle verkopers één mailbox. De ontvanger ziet wel de
# naam van de juiste verkoper als afzendernaam en in de handtekening.
# Zodra de zakelijke adressen klaar zijn: pas deze twee regels aan, of
# geef iemand een eigen mailbox via users.json (smtp_address/smtp_password).
SMTP_ADDRESS=jouw.adres@gmail.com
SMTP_PASSWORD=abcdefghijklmnop

# --- Flask ---------------------------------------------------------
# Willekeurige geheime sleutel voor de login-sessies. Genereer met:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Verander je deze later, dan moet iedereen opnieuw inloggen.
FLASK_SECRET=vervang-dit-door-een-willekeurige-string

# Adres en poort waarop de app luistert.
#   0.0.0.0 = bereikbaar via het netwerk (nodig voor Tailscale)
#   het getal achter de dubbele punt is de poort
# Is 5000 al bezet op je server? Kies dan bijvoorbeeld 5050 of 8080.
# Controleer wat vrij is met:   sudo ss -tulpn | grep LISTEN
#
# BIND wordt gebruikt op de SERVER (gunicorn/systemd).
BIND=0.0.0.0:5000

# FLASK_HOST en FLASK_PORT gelden enkel LOKAAL (run.py op je eigen pc).
# Houd ze gelijk aan BIND om verwarring te vermijden.
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# --- Meldingen aan de verkoper zelf --------------------------------
# Staan UIT zolang iedereen dezelfde mailbox deelt: anders komen de
# meldingen van alle drie de verkopers in dezelfde inbox terecht.
# Zet op 1 zodra elke verkoper een eigen zakelijk adres heeft
# (en vul dan per persoon notify_email in users.json in).
DIGEST_ENABLED=0
OWNER_PINGS_ENABLED=0

# Tijdstip van het ochtend-overzicht (enkel relevant als DIGEST_ENABLED=1)
DIGEST_HOUR=7
DIGEST_MINUTE=30

# Na hoeveel dagen zonder reactie een 'niet overtuigd'-lead als
# opvolg-suggestie verschijnt.
STALE_LEAD_DAYS=5

# --- Back-ups ------------------------------------------------------
# Elke nacht een kopie van de database, met dit aantal dagen historiek.
BACKUP_HOUR=3
BACKUP_KEEP_DAYS=7
